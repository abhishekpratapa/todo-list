node_modules/
dist/
*.log
.DS_Store
# the command-line tool, staged for the app bundle by `npm run dist`
/build/bin/
# local test data never belongs in the repo
/data/
*.tmp
# local secrets and per-user settings never belong in the repo either
.env
.env.*
.claude/settings.local.json
# where a plain `go build` in cli/ puts the binary (cli/build.sh uses cli/dist/)
/cli/todos

# iPhone app: build output, and anything per-user or secret
ios/build/
ios/TodosKit/.build/
ios/**/.swiftpm/
xcuserdata/
*.xcuserstate
DerivedData/
# signing material and keys never belong in the repo
*.mobileprovision
*.provisionprofile
*.p8
*.p12
*.cer
*.certSigningRequest
