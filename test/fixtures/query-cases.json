  "cases": [
    { "name": "default order: in progress, blocked, to do, done; open by priority then due date (undated last); done by most recently finished, never-stamped last; ties by id",
      "expect": [2, 12, 15, 5, 1, 6, 7, 13, 3, 16, 8, 4, 10, 14, 9, 11] },
    { "name": "\"default\" names the same order", "sort": "default", "expect": [2, 12, 15, 5, 1, 6, 7, 13, 3, 16, 8, 4, 10, 14, 9, 11] },
    { "name": "open tasks in the default order", "filter": { "status": "open" }, "expect": [2, 12, 15, 5, 1, 6, 7, 13, 3, 16, 8, 4] },

    { "name": "due ascending; undated last; ties by id", "filter": { "status": "open" }, "sort": "due", "expect": [15, 1, 12, 7, 2, 6, 13, 3, 5, 16, 8, 4] },
    { "name": "due descending; undated still last; ties still by ascending id", "filter": { "status": "open" }, "sort": "-due", "expect": [8, 16, 5, 3, 2, 6, 13, 7, 12, 1, 15, 4] },
    { "name": "priority ascending is most important first", "filter": { "status": "open" }, "sort": "priority", "expect": [1, 2, 6, 15, 3, 5, 7, 12, 13, 4, 8, 16] },
    { "name": "priority descending is least important first", "filter": { "status": "open" }, "sort": "-priority", "expect": [4, 8, 16, 3, 5, 7, 12, 13, 1, 2, 6, 15] },
    { "name": "several keys: due, then least important first", "filter": { "status": "open" }, "sort": "due,-priority", "expect": [15, 1, 12, 7, 13, 2, 6, 3, 5, 16, 8, 4] },
    { "name": "keys are trimmed and ignore case", "filter": { "status": "open" }, "sort": " Due , -PRIORITY ", "expect": [15, 1, 12, 7, 13, 2, 6, 3, 5, 16, 8, 4] },
    { "name": "created ascending, ties by id", "sort": "created", "expect": [15, 1, 11, 6, 9, 5, 3, 10, 2, 14, 4, 12, 7, 8, 13, 16] },
    { "name": "created descending, ties still by ascending id", "sort": "-created", "expect": [13, 16, 8, 7, 12, 4, 14, 2, 10, 3, 5, 9, 6, 11, 1, 15] },
    { "name": "updated descending", "filter": { "status": "open" }, "sort": "-updated", "expect": [12, 2, 3, 16, 5, 13, 8, 7, 4, 1, 15, 6] },
    { "name": "completed descending: tasks never completed go last, by id", "sort": "-completed", "expect": [10, 14, 9, 1, 2, 3, 4, 5, 6, 7, 8, 11, 12, 13, 15, 16] },
    { "name": "completed ascending: still last", "filter": { "status": "done" }, "sort": "completed", "expect": [9, 10, 14, 11] },
    { "name": "title, alphabetically", "sort": "title", "expect": [8, 4, 7, 11, 2, 15, 16, 13, 6, 5, 1, 12, 9, 14, 10, 3] },
    { "name": "title ignores case, and a shorter title comes before a longer one it starts", "tasks": "titles", "sort": "title", "expect": [5, 2, 3, 7, 6, 1, 4] },
    { "name": "title descending; titles that differ only in case stay in id order", "tasks": "titles", "sort": "-title", "expect": [4, 1, 6, 7, 2, 3, 5] },
    { "name": "project ignores case; no project goes last", "filter": { "status": "open" }, "sort": "project", "expect": [1, 6, 8, 15, 2, 3, 5, 12, 4, 7, 13, 16] },
    { "name": "project descending; no project still last", "filter": { "status": "open" }, "sort": "-project", "expect": [2, 3, 5, 12, 1, 6, 8, 15, 4, 7, 13, 16] },
    { "name": "project, then due descending", "filter": { "status": "open" }, "sort": "project,-due", "expect": [8, 6, 1, 15, 5, 3, 2, 12, 16, 13, 7, 4] },
    { "name": "status alone; ties by id", "filter": { "status": "open" }, "sort": "status", "expect": [2, 12, 5, 15, 1, 3, 4, 6, 7, 8, 13, 16] },
    { "name": "status descending: done first", "sort": "-status", "expect": [9, 10, 11, 14, 1, 3, 4, 6, 7, 8, 13, 16, 5, 15, 2, 12] },
    { "name": "id descending", "filter": { "status": "open" }, "sort": "-id", "expect": [16, 15, 13, 12, 8, 7, 6, 5, 4, 3, 2, 1] },
    { "name": "default can follow another key", "filter": { "status": "open" }, "sort": "priority,default", "expect": [2, 15, 1, 6, 12, 5, 7, 13, 3, 16, 8, 4] },
    { "name": "titles alone, in the default order, go by id", "tasks": "titles", "expect": [1, 2, 3, 4, 5, 6, 7] },

    { "name": "an unknown sort key is refused", "sort": "dew", "error": "sort" },
    { "name": "an unknown key later in the list is refused", "sort": "due,-nope", "error": "sort" },
    { "name": "the default order can't be reversed", "sort": "-default", "error": "sort" },

    { "name": "status: one", "filter": { "status": "done" }, "expect": [10, 14, 9, 11] },
    { "name": "status: several", "filter": { "status": "blocked,in_progress" }, "expect": [2, 12, 15, 5] },
    { "name": "status: open and done together are everything", "filter": { "status": "open,done" }, "expect": [2, 12, 15, 5, 1, 6, 7, 13, 3, 16, 8, 4, 10, 14, 9, 11] },
    { "name": "status: all", "filter": { "status": "all" }, "expect": [2, 12, 15, 5, 1, 6, 7, 13, 3, 16, 8, 4, 10, 14, 9, 11] },
    { "name": "priority, any status", "filter": { "priority": "high" }, "expect": [2, 15, 1, 6, 9] },
    { "name": "priority: several are OR'ed, and AND'ed with status", "filter": { "status": "open", "priority": "high,low" }, "expect": [2, 15, 1, 6, 16, 8, 4] },
    { "name": "assignee", "filter": { "assignee": "claude" }, "expect": [2, 12, 3] },
    { "name": "project ignores case", "filter": { "project": "work" }, "expect": [2, 12, 5, 3, 9] },
    { "name": "project: several", "filter": { "status": "open", "project": "Home,WORK" }, "expect": [2, 12, 15, 5, 1, 6, 3, 8] },
    { "name": "project: empty means no project", "filter": { "project": "" }, "expect": [7, 13, 16, 4, 11] },
    { "name": "project: a name or no project", "filter": { "status": "open", "project": "work," }, "expect": [2, 12, 5, 7, 13, 3, 16, 4] },
    { "name": "project: a name with a comma in it still matches as a whole, besides its parts", "tasks": "commas", "filter": { "project": "Q4, planning" }, "expect": [1, 2, 3] },
    { "name": "project: one name matches only that project", "tasks": "commas", "filter": { "project": "q4" }, "expect": [2] },
    { "name": "tag, ignoring case and a leading #", "filter": { "tag": "#Errands" }, "expect": [15, 1, 13, 4] },
    { "name": "tags: any of them by default", "filter": { "tag": "#errands,@money" }, "expect": [15, 1, 6, 13, 4] },
    { "name": "tags: tagMode any says the same", "filter": { "tag": "errands,money", "tagMode": "any" }, "expect": [15, 1, 6, 13, 4] },
    { "name": "tags: tagMode all wants every one", "filter": { "tag": "errands,money", "tagMode": "all" }, "expect": [13] },
    { "name": "due overdue leaves out finished tasks", "filter": { "due": "overdue" }, "expect": [12, 15, 1, 7] },
    { "name": "due today", "filter": { "due": "today" }, "expect": [2, 6, 13] },
    { "name": "due tomorrow", "filter": { "due": "tomorrow" }, "expect": [3] },
    { "name": "due tomorrow, across a month's end", "today": "2026-09-30", "filter": { "due": "tomorrow" }, "expect": [15] },
    { "name": "due week: today through 7 days out", "filter": { "due": "week" }, "expect": [2, 5, 6, 13, 3, 16] },
    { "name": "due week includes its last day", "today": "2026-11-23", "filter": { "due": "week" }, "expect": [8] },
    { "name": "due none", "filter": { "due": "none" }, "expect": [4, 14, 11] },
    { "name": "due any", "filter": { "status": "open", "due": "any" }, "expect": [2, 12, 15, 5, 1, 6, 7, 13, 3, 16, 8] },
    { "name": "due on a bare date: on or before it", "filter": { "due": "2026-10-14" }, "expect": [12, 15, 1, 7, 9] },
    { "name": "due before a date leaves that day out", "filter": { "due": "before:2026-10-14" }, "expect": [12, 15, 1, 9] },
    { "name": "due after a date leaves that day out", "filter": { "due": "after:2026-10-17" }, "expect": [5, 16, 8] },
    { "name": "due values ignore case", "filter": { "due": "Today" }, "expect": [2, 6, 13] },
    { "name": "search covers subtasks", "filter": { "q": "budget" }, "expect": [3] },
    { "name": "search covers notes; every word must appear, in any order", "filter": { "q": "lake venue" }, "expect": [5] },
    { "name": "search covers projects and tags, ignoring case", "filter": { "q": "WORK bug" }, "expect": [2, 12] },
    { "name": "search covers tags", "filter": { "q": "writing" }, "expect": [3, 9] },
    { "name": "fields combine", "filter": { "status": "open", "priority": "high,medium", "project": "work", "due": "week" }, "sort": "due", "expect": [2, 3, 5] },
    { "name": "an empty value doesn't narrow the list", "filter": { "priority": "", "assignee": "", "tag": "", "due": "", "q": "  " }, "expect": [2, 12, 15, 5, 1, 6, 7, 13, 3, 16, 8, 4, 10, 14, 9, 11] },
    { "name": "a value that names nothing matches nothing", "filter": { "status": "," }, "expect": [] },
    { "name": "a tag list that names nothing matches nothing", "filter": { "tag": ", #" }, "expect": [] },

    { "name": "an unknown status is refused", "filter": { "status": "finished" }, "error": "filter" },
    { "name": "an unknown priority is refused", "filter": { "priority": "high,urgent" }, "error": "filter" },
    { "name": "an unknown assignee is refused", "filter": { "assignee": "bob" }, "error": "filter" },
    { "name": "an unknown due value is refused", "filter": { "due": "whenever" }, "error": "filter" },
    { "name": "before: needs a date", "filter": { "due": "before:soon" }, "error": "filter" },
    { "name": "an unknown tagMode is refused", "filter": { "tag": "errands", "tagMode": "some" }, "error": "filter" },

    { "name": "Today: overdue, then due today; each by priority, then oldest first, then id", "view": "today",
      "expect": { "overdue": [15, 1, 12, 7], "today": [2, 6, 13] } },
    { "name": "Today, a few days later", "view": "today", "today": "2026-10-20",
      "expect": { "overdue": [15, 1, 2, 6, 12, 7, 13, 3], "today": [5] } },
    { "name": "Today, with nothing due", "view": "today", "tasks": "titles",
      "expect": { "overdue": [], "today": [] } }
  ]
