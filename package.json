{
  "name": "todolist",
  "productName": "Todos",
  "version": "1.4.0",
  "description": "A todo list shared between you and your Claude Code / Cowork sessions (via MCP).",
  "type": "module",
  "main": "electron/main.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "mcp": "node src/mcp.js",
    "test": "node --test \"test/*.test.js\"",
    "app": "electron .",
    "icon": "python3 scripts/make-icon.py",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.abhishekpratapa.todos",
    "productName": "Todos",
    "copyright": "Personal use",
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Todos",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
